void setup() {
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(16, OUTPUT);
  pinMode(12, INPUT);
  // put your setup code here, to run once:

}

void loop() {
  int lectura=digitalRead(12);
  if(lectura==1){
    digitalWrite(3,1);
    digitalWrite(2,1);
    digitalWrite(16,1);
    delay(2000);
  }
  else{
    digitalWrite(3,0);
    digitalWrite(2,0);
    digitalWrite(16,0);
  // put your main code here, to run repeatedly:
  }
}
